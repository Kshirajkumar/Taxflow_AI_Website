# These two public values are embedded in browser code; use only the public publishable key.
# Never use SUPABASE_SECRET_KEY in this website.
SUPABASE_URL=https://your-existing-taxflow-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-existing-project-publishable-key

# Optional: API origin for the client portal. Defaults to the TaxFlow API in production.
API_URL=https://taxflow-ai.onrender.com

# Optional: use an HTTPS endpoint instead of inserting into website_waitlist.
# VITE_WAITLIST_ENDPOINT=https://your-domain.example/api/waitlist
