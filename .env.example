# Reuse the existing TaxFlow app Supabase project and its public anon/publishable key.
# Copy the existing project's public URL and anon/publishable key from the app .env or dashboard.
# Never use SUPABASE_SERVICE_ROLE_KEY in this website.
VITE_SUPABASE_URL=https://your-existing-taxflow-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-existing-project-anon-or-publishable-key

# Optional: use an HTTPS endpoint instead of inserting into website_waitlist.
# VITE_WAITLIST_ENDPOINT=https://your-domain.example/api/waitlist
