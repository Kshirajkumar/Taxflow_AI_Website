{
  "name": "taxflow-ai-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-site-files.mjs && tsc -b && vite build",
    "check-types": "tsc --noEmit",
    "capture:previews": "npm run build && node scripts/capture-social-previews.mjs",
    "check:seo": "npm run build && node scripts/check-site-seo.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.65.0",
    "turbo": "^2.11.11",
    "typescript": "^5.6.3",
    "vite": "^7.3.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0 <12"
    }
  }
}
